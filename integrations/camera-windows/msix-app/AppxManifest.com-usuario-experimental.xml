            DisplayName="Quall Virtual Camera Source" ThreadingModel="Both" />
        </com4:InProcessServer>
      </com4:ComServer>
    </com4:Extension>
  </Extensions>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
