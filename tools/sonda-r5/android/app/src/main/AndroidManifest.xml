<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sondas da fase 0 do R5. CAMERA para a S-A1..S-A4; RECORD_AUDIO para a S-A5 e a S-A6, que
         abrem o microfone e **não guardam som**: só contam amostras e medem nível (ver README). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Sonda R5"
        android:allowBackup="false">
        <activity
            android:name=".SondaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A S-A5: sobe com `camera` e tenta acrescentar `microphone` depois. -->
        <service
            android:name=".ServicoDaSondaA5"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
