<?xml version="1.0" encoding="utf-8"?>
<!-- Um roteiro guardado: de onde veio, quando, o tamanho, a prévia, e ver / usar este / apagar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@color/q_superficie"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/textRoteiroOrigem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textRoteiroQuando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textRoteiroPrevia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonVerRoteiro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/tp_ver"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonUsarRoteiro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.3"
            android:text="@string/tp_usar_este"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonApagarRoteiro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tp_apagar"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
