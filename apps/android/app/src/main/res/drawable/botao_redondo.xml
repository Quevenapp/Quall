<?xml version="1.0" encoding="utf-8"?>
<!--
  O botão redondo (§4): um círculo de 40 dp na superfície, com o contorno. A área de toque é de 48 dp
  (a vista); o desenho recua 4 dp de cada lado.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
    <ripple android:color="#24FFFFFF">
        <item>
            <shape android:shape="oval">
                <solid android:color="@color/q_superficie" />
                <stroke android:width="1dp" android:color="@color/q_contorno" />
            </shape>
        </item>
    </ripple>
</inset>
