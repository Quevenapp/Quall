<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha da lista de aparelhos (Exibir, Controlar): a superfície com o contorno, cantos de 16. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#24FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/q_superficie" />
            <stroke android:width="1dp" android:color="@color/q_contorno" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
