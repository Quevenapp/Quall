<?xml version="1.0" encoding="utf-8"?>
<!-- O fundo do Início (§2): o acento a 22 % no alto, sumindo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/q_fundo" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.0"
                android:endColor="#000B0B0F"
                android:gradientRadius="130%p"
                android:startColor="#386A5AF9"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
