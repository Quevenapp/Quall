<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: a única memória compartilhada entre o app e a extension, que são processos
	     separados. É por aqui que passam o pedido (PIN, porta, nome), o estado que a tela de
	     espera mostra, o recado do Cancelar e o pareamento persistido.

	     NÃO acrescentar com.apple.developer.networking.multicast aqui antes de o App ID mostrar a
	     chave habilitada: se acrescentar antes, a falha vira erro de compilação e parece
	     regressão. O pedido está com a Apple; enquanto isso vale o IP digitado, que é o fallback
	     obrigatório do fluxo. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.br.com.queven.quall</string>
	</array>
</dict>
</plist>
